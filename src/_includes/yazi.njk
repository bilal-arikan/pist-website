---
layout: base.njk
---
<article class="yazi">
  <div class="wrap">
    <a class="geri" href="/tr/blog/">← Tüm yazılar</a>
    <p class="eyebrow" style="color:{{ hue }}">{{ category }}</p>
    <h1>{{ title }}</h1>
    <div class="künye">
      <span>{{ date | tarihTR }}</span>
      <span>{{ readingTime }} dk okuma</span>
      <span>Pist Studio</span>
    </div>
    <div class="prose">
      {{ content | safe }}
    </div>
  </div>
</article>
